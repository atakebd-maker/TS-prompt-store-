# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TS Prompt Store Admin Configuration:
# Default initial admin credentials (hashed upon first server initialization):
ADMIN_EMAIL="admin@tspromptstore.com"
ADMIN_PASSWORD="AdminSecurePrompt2026!"
